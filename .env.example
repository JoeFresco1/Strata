STRATA_DB_BACKEND=postgres
STRATA_DATABASE_URL=postgresql://strata:strata@127.0.0.1:55433/strata
STRATA_POSTGRES_ADMIN_URL=postgresql://strata:strata@127.0.0.1:55433/postgres
STRATA_EXPORTS_DIR=./exports
STRATA_EMBEDDINGS_ENABLED=true
STRATA_EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
STRATA_EMBEDDINGS_INSECURE_DOWNLOAD_FALLBACK=false
STRATA_MODEL_ROOT=./models
STRATA_MODEL_NAME=local-model
# Optional bearer token for the configured OpenAI-compatible endpoint:
# STRATA_MODEL_API_KEY=
# Optional when Strata should manage llama.cpp itself:
# LLAMA_SERVER_EXE=/absolute/path/to/llama-server
# STRATA_MODEL_PATH=/absolute/path/to/model.gguf
LLAMA_BASE_URL=http://127.0.0.1:8080
LLAMA_CONTEXT_SIZE=8192
LLAMA_GPU_LAYERS=0
LLAMA_TEMPERATURE=0.4
LLAMA_TOP_P=0.9
LLAMA_REASONING_MODE=off
LLAMA_REASONING_FORMAT=none
LLAMA_REASONING_BUDGET=0
STRATA_HOST=127.0.0.1
STRATA_PORT=8000
STRATA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
